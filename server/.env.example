# --- Server ---
PORT=4000

# Comma-separated list of exact frontend origins allowed to call this server.
# Add your HTTPS tunnel / production domain here. Never use * in production.
CLIENT_ORIGIN=http://localhost:5173

# Set to true to serve the built client (client/dist) from this server too.
SERVE_CLIENT=false

# --- STUN / TURN (served to clients via GET /api/ice-servers) ---
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN URLs. Include UDP and TCP/TLS variants for restrictive networks, e.g.
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=

# Option A (recommended, self-hosted coturn with "use-auth-secret"):
# the server mints short-lived credentials from this shared secret.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Option B (managed provider with static credentials):
TURN_USERNAME=
TURN_CREDENTIAL=
